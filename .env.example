# HTTPS origin only; never append /mcp. OAuth callback is this value + /auth/callback.
PUBLIC_BASE_URL=https://replace-with-your-service.example
GITHUB_CLIENT_ID=replace-in-host-secret-manager
GITHUB_CLIENT_SECRET=replace-in-host-secret-manager
# Stable random secret of at least 32 bytes; store only in the host secret manager.
JWT_SIGNING_KEY=replace-with-long-random-secret
SETUP_TOKEN=replace-with-one-time-random-token
CREDENTIAL_ENCRYPTION_KEY=replace-with-fernet-key
REST_API_TOKEN=replace-with-long-random-bearer-token
LIVE_TRADING=false
LIVE_CONFIRMATION=
PREAUTHORIZED_AUTO_EXECUTION=false
SIGNAL_WORKER_ENABLED=false
SIGNAL_SCAN_INTERVAL_SECONDS=15
SIGNAL_MAX_AGE_SECONDS=90
SIGNAL_FEED_URL=
SIGNAL_FEED_BEARER_TOKEN=
EXECUTOR_BASE_URL=https://memecoin-mcp-server-production.up.railway.app
RESEARCH_FEED_ENABLED=false
RESEARCH_SCAN_INTERVAL_SECONDS=30
RESEARCH_MARKET_PAGES=2
RESEARCH_FEED_STATE_PATH=/app/data/research_feed.json

# Conservative source-linked evidence adapter (separate Railway service)
EVIDENCE_ADAPTER_ENABLED=false
EVIDENCE_SCAN_INTERVAL_SECONDS=300
EVIDENCE_REQUEST_SPACING_SECONDS=2.5
EVIDENCE_HTTP_MAX_RETRIES=3
POSITION_SUPERVISOR_ENABLED=false
POSITION_SUPERVISION_INTERVAL_SECONDS=15
RESEARCH_FEED_URL=https://your-research-feed.example
# Optional comma-separated reputable RSS feeds. Defaults to CoinDesk + Decrypt.
EVIDENCE_NEWS_RSS_URLS=
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
PILOT_NOTIONAL_USDC=23.75
PILOT_MAX_LOSS_USDC=2.50
# Human-directed opportunity policy 1.0. Hard identity, safety, Coinbase,
# one-position, loss-cap and circuit-breaker controls are not configurable here.
LIVE_MIN_MODEL_SCORE=78
LIVE_ALLOW_MIXED_REGIME=true
LIVE_REQUIRE_NEWS_CATALYST=false
LIVE_MIN_NEWS_SCORE=4
LIVE_MIN_MARKET_CAP_USD=25000000
LIVE_MIN_VOLUME_24H_USD=5000000
LIVE_MIN_TURNOVER=0.03
LIVE_MAX_TURNOVER=1.50
LIVE_MAX_24H_GAIN_PCT=15

# Paper-only multi-asset research engine. No broker execution adapter is
# present in this release, even if these flags are enabled.
MULTI_ASSET_WORKER_ENABLED=false
MULTI_ASSET_FEED_URL=
MULTI_ASSET_FEED_TOKEN=
MULTI_ASSET_SCAN_INTERVAL_SECONDS=60
MULTI_ASSET_LEDGER_PATH=/app/data/multi_asset.jsonl
FOREX_ENGINE_ENABLED=false
EQUITY_ENGINE_ENABLED=false
OPTION_ENGINE_ENABLED=false
CRYPTO_ENGINE_ENABLED=false
ASSET_MAX_OPEN_POSITIONS=3
ASSET_MAX_HOLD_MINUTES=240
ASSET_MAX_RISK_USD=25.00
ASSET_MIN_SCORE=75
ASSET_MAX_SPREAD_BPS=35
ASSET_MAX_SNAPSHOT_AGE_SECONDS=180
# Multi-week crypto snapshots are chain-neutral and must include independently
# verified execution, safety, concentration, daily trend and holder evidence.
MULTI_WEEK_CRYPTO_NETWORKS=solana,base,robinhood
MULTI_WEEK_CRYPTO_EXPECTED_HOLD_DAYS=21
MULTI_WEEK_CONFIRMATION_PATH=/app/data/multi_week_confirmations.json
MAX_CAPITAL_ALLOCATION_PCT=95
ENTRY_TIMEOUT_SECONDS=45
MAX_ENTRY_DRIFT_BPS=35
DATA_DIR=/app/data
TRADING_INTELLIGENCE_RAW_RETENTION_HOURS=24
TRADING_INTELLIGENCE_HARD_CONTROL_RETENTION_DAYS=7
TRADING_INTELLIGENCE_RUN_RETENTION_DAYS=7
PORT=8080

# Verified high-impact Forex calendar adapter.
ECONOMIC_CALENDAR_ENABLED=false
ECONOMIC_CALENDAR_PROVIDER=generic
ECONOMIC_CALENDAR_INTERVAL_SECONDS=300
ECONOMIC_CALENDAR_LOOKAHEAD_DAYS=7
ECONOMIC_CALENDAR_REQUIRE_EVENTS=true
# Free, fail-closed aggregation of BLS, Federal Reserve, ECB, BOE and BOJ.
# This mode requires no API key and permits an empty event window only after
# every required currency source has been fetched and parsed successfully.
OFFICIAL_CALENDAR_REQUIRED_CURRENCIES=USD,EUR,GBP,JPY
TRADING_ECONOMICS_API_KEY=
TRADING_ECONOMICS_COUNTRIES=united states,euro area,united kingdom,japan,canada,australia

# Server-owned hourly Forex dashboard delivery. Keep credentials in Railway secrets.
FOREX_EMAIL_REPORT_ENABLED=false
# Use gmail_api for HTTPS port 443 delivery from an existing Gmail account.
FOREX_EMAIL_PROVIDER=gmail_api
FOREX_EMAIL_TIMEZONE=America/New_York
FOREX_EMAIL_RECIPIENTS=
FOREX_EMAIL_FROM=
FOREX_EMAIL_GMAIL_CLIENT_ID=
FOREX_EMAIL_GMAIL_CLIENT_SECRET=
FOREX_EMAIL_GMAIL_REFRESH_TOKEN=
# Optional Resend HTTPS fallback.
FOREX_EMAIL_RESEND_API_KEY=
FOREX_EMAIL_TIMEOUT_SECONDS=20
# Optional SMTP fallback.
FOREX_EMAIL_SMTP_HOST=smtp.gmail.com
FOREX_EMAIL_SMTP_PORT=587
FOREX_EMAIL_SMTP_STARTTLS=true
FOREX_EMAIL_SMTP_USERNAME=
FOREX_EMAIL_SMTP_PASSWORD=
FOREX_EMAIL_SMTP_TIMEOUT_SECONDS=20
FOREX_EMAIL_RETRY_SECONDS=300

# Forex NAV-based compounding and portfolio risk controls
FOREX_RISK_PER_TRADE_PCT=0.01
FOREX_MAX_OPEN_POSITIONS=2
FOREX_MIN_EXECUTABLE_RISK_USD=0.10
# Optional absolute emergency ceilings; 0 leaves NAV-based limits in control.
FOREX_ABSOLUTE_MAX_NOTIONAL_USD=0
FOREX_ABSOLUTE_MAX_MARGIN_USED_USD=0

# Separate Solana early-discovery sleeve. Store every secret only in Railway.
SOLANA_EARLY_ENABLED=false
COINGECKO_API_KEY=
COINGECKO_ONCHAIN_BASE_URL=https://pro-api.coingecko.com/api/v3/onchain
JUPITER_API_KEY=
HELIUS_API_KEY=
HELIUS_WEBHOOK_AUTH=
SOLANA_WATCH_WALLETS=
SOLANA_EARLY_LEDGER_PATH=/app/data/solana_early.sqlite3
SOLANA_EARLY_SCAN_INTERVAL_SECONDS=20
SOLANA_EARLY_MIN_SCORE=78
SOLANA_EARLY_MAX_PROBE_USD=3
SOLANA_EARLY_LIVE_ENABLED=false
SOLANA_EXECUTOR_ENABLED=false
SOLANA_DISCOVERY_URL=
SOLANA_WALLET_PRIVATE_KEY=
SOLANA_EXECUTOR_STATE_PATH=/app/data/solana_executor.json
SOLANA_MIN_PAPER_OBSERVATIONS=50
SOLANA_MAX_ENTRY_USD=3
SOLANA_MAX_TOTAL_EXPOSURE_USD=6
SOLANA_MAX_POSITIONS=2
SOLANA_STOP_LOSS_PCT=0.18
SOLANA_TAKE_PROFIT_PCT=0.40
SOLANA_TRAILING_STOP_PCT=0.15
SOLANA_LIVE_ENABLED=false
SOLANA_LIVE_ACK=
SOLANA_MICROCAP_SUB_1M_SHADOW_ENABLED=true
SOLANA_MICROCAP_SHADOW_MIN_MARKET_CAP_USD=100000
SOLANA_MICROCAP_SHADOW_MAX_MARKET_CAP_USD=1000000
